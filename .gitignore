.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
__pycache__/
*.py[cod]
*.egg-info/
.DS_Store

# Competition-derived data and generated artifacts stay local.
/data/
artifacts/cache/
artifacts/backtests/
artifacts/models/
artifacts/predictions/
artifacts/reproduction/
artifacts/submissions/*.csv
artifacts/locks/
*.joblib
*.pkl

# Receipts/manifests and reviewer-facing reports remain trackable.
!artifacts/manifests/
!artifacts/registry/
!artifacts/submissions/*.json
!reports/

# Competition ZIP is not committed (user supplies it)
inputs/competition/*.zip

# Track generated feature blocks (script-reproducible)
!artifacts/features/

# Track reports and planning
!reports/
!.planning/
